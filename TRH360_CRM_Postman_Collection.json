              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"channel\": \"whatsapp\",\n  \"direction\": \"outbound\",\n  \"content\": \"Namaste Lakshmi garu, here is the proposal link and Saturday meeting invite.\",\n  \"sentBy\": \"Sravani K.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/messages", "host": ["{{baseUrl}}"], "path": ["api", "messages"] }
          }
        }
      ]
    },
