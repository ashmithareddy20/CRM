# Copy to .dev.vars for local Worker development. Do not commit actual values.
DEPLOYMENT_ENV=development
OIDC_ISSUER=https://issuer.example.com
OIDC_AUDIENCE=trh360-crm-api
OIDC_ALLOWED_ALGORITHMS=RS256
# Optional when discovery's standard JWKS path is not used.
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=https://localhost:5173
# Generate distinct base64url 32-byte values. FIELD_ENCRYPTION_KEYS is a versioned JSON key ring.
FIELD_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_32_BYTE_BASE64URL_KEY"}
FIELD_ENCRYPTION_ACTIVE_VERSION=v1
BLIND_INDEX_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
AUDIT_ANCHOR_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
# Only the Workers test environment may enable this. It cannot authorize development or production requests.
ALLOW_TEST_IDENTITY=false
# Patient ingestion remains synthetic-only locally. Production is fail-closed until policy review.
PATIENT_DATA_INGESTION=synthetic_only
# Bind these names through Wrangler/IaC; values belong in Cloudflare secret storage, never this file.
# WORK_QUEUE, WORK_DLQ, EVIDENCE_BUCKET, BACKUP_BUCKET
# BACKUP_SIGNING_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
# RETENTION_POLICY_REGISTRY=server-managed
