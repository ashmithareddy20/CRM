        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "{{appointmentId}}"] }
          }
        }
      ]
    },
    {
      "name": "8. AI Reviews & Human Confirmation",
      "item": [
        {
          "name": "List AI Review Drafts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api", "reviews"] },
            "description": "Lists pending AI-generated draft remarks awaiting human confirmation."
          }
        },
        {
          "name": "Create AI Review Draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"confidence\": 91,\n  \"suggestedTemperature\": \"Hot\",\n  \"suggestedObjection\": \"Implementation cost\",\n  \"summaryText\": \"Enterprise CRM rollout requested. High intent with time-bound need.\",\n  \"structuredRemark\": {\n    \"leadRequirement\": \"Enterprise CRM rollout before festive sales cycle.\",\n    \"intentUrgency\": \"High intent. Time-bound need within 4-6 weeks.\",\n    \"decisionMaker\": \"Finance director Priya\",\n    \"primaryObjection\": \"Implementation cost and annual payment terms.\",\n    \"commitmentObtained\": \"Solution review accepted for Saturday 11:30 AM.\",\n    \"nextAction\": \"Call today at 4:30 PM to confirm finance director availability.\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api", "reviews"] }
          }
        },
        {
          "name": "Approve AI Review (Human Confirmation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewedBy\": \"Sravani K.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reviews/{{reviewId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "{{reviewId}}", "approve"] },
            "description": "Applies human confirmation to AI draft, committing to permanent record."
          }
        },
        {
          "name": "Reject AI Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewedBy\": \"Sravani K.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reviews/{{reviewId}}/reject", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "{{reviewId}}", "reject"] }
          }
        }
      ]
    },
    {
      "name": "9. Messages (WhatsApp / SMS)",
      "item": [
