{
  "info": {
    "_postman_id": "trh360-crm-complete-backend-2026",
    "name": "TRH360 CRM — Complete Production Backend API",
    "description": "Comprehensive API collection for TRH360 Human + AI CRM covering Leads, Lead 360, Calls, Click-to-Call Dialer, Notes, Tasks, Appointments, AI Reviews with Human Confirmation, Messages, Analytics, Auth, and Audit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5173",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "TRH-24190",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "REV-001",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "TASK-001",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "APPT-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] },
            "description": "Liveness check confirming server and database status."
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sravani@crm.example\",\n  \"password\": \"demoPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Authenticates user and returns session token and permissions."
          }
        },
        {
          "name": "Current User Profile (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Returns active user context, role, and capabilities."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "Terminates active session."
          }
        }
      ]
    },
    {
      "name": "3. Leads & Lead 360",
      "item": [
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/leads", "host": ["{{baseUrl}}"], "path": ["api", "leads"] },
            "description": "Retrieves all leads ordered by latest first with search/status filters."
          }
        },
        {
          "name": "Create Lead (Add Lead Form)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Varma\",\n  \"phone\": \"+91 98480 12345\",\n  \"email\": \"ravi.varma@example.com\",\n  \"source\": \"Google Search · Enterprise\",\n  \"status\": \"new\",\n  \"ownerId\": \"agent-1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/leads", "host": ["{{baseUrl}}"], "path": ["api", "leads"] },
            "description": "Persists a new lead and creates an audit log entry."
          }
        },
        {
          "name": "Get Lead 360 (Lead + Child Relations)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/leads/{{leadId}}", "host": ["{{baseUrl}}"], "path": ["api", "leads", "{{leadId}}"] },
            "description": "Returns full Lead 360 view including calls, notes, tasks, appointments, reviews, and messages."
          }
        },
        {
          "name": "Get Lead Journey Timeline",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/leads/{{leadId}}/timeline", "host": ["{{baseUrl}}"], "path": ["api", "leads", "{{leadId}}", "timeline"] },
            "description": "Unified chronological journey stream across all channels."
          }
        },
        {
          "name": "Update Lead",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"qualified\",\n  \"ownerId\": \"Sravani\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/leads/{{leadId}}", "host": ["{{baseUrl}}"], "path": ["api", "leads", "{{leadId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Calls & Dialer",
      "item": [
        {
          "name": "List Calls",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/calls?leadId={{leadId}}", "host": ["{{baseUrl}}"], "path": ["api", "calls"], "query": [{ "key": "leadId", "value": "{{leadId}}" }] }
          }
        },
        {
          "name": "Log Completed Call",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"agentId\": \"agent-1\",\n  \"direction\": \"outbound\",\n  \"outcome\": \"connected_positive\",\n  \"durationSec\": 278\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/calls", "host": ["{{baseUrl}}"], "path": ["api", "calls"] }
          }
        },
        {
          "name": "Click-to-Call Dialer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"agentId\": \"agent-1\",\n  \"phone\": \"+91 98491 22618\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/calls/dial", "host": ["{{baseUrl}}"], "path": ["api", "calls", "dial"] }
          }
        }
      ]
    },
    {
      "name": "5. Notes & Remarks",
      "item": [
        {
          "name": "List Notes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/notes?leadId={{leadId}}", "host": ["{{baseUrl}}"], "path": ["api", "notes"], "query": [{ "key": "leadId", "value": "{{leadId}}" }] }
          }
        },
        {
          "name": "Create Note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"authorId\": \"agent-1\",\n  \"content\": \"Client requested annual billing structure with quarterly payments.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notes", "host": ["{{baseUrl}}"], "path": ["api", "notes"] }
          }
        }
      ]
    },
    {
      "name": "6. Tasks & Cadence",
      "item": [
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tasks?leadId={{leadId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks"], "query": [{ "key": "leadId", "value": "{{leadId}}" }] }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"assigneeId\": \"agent-1\",\n  \"title\": \"Confirm Saturday product demo slot\",\n  \"status\": \"open\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "Update Task Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
          }
        }
      ]
    },
    {
      "name": "7. Appointments & Meetings",
      "item": [
        {
          "name": "List Appointments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/appointments?leadId={{leadId}}", "host": ["{{baseUrl}}"], "path": ["api", "appointments"], "query": [{ "key": "leadId", "value": "{{leadId}}" }] }
          }
        },
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"ownerId\": \"Maya Rao\",\n  \"mode\": \"online\",\n  \"status\": \"booked\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] }
