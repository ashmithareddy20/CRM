{
  "info": {
    "_postman_id": "trh360-crm-api-collection-2026",
    "name": "TRH360 CRM \u2014 authenticated v1 API",
    "description": "Canonical authenticated /api/v1 contract. Configure an HTTPS API origin, bearer test token only in non-production, and a tenant ID only when supported by the identity provider. Calls and remarks use real lead and membership IDs returned by the service; no client-supplied owner or role is trusted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://crm.example.com",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "callAttemptId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sourceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "membershipId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health and authenticated workspace",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Liveness only; no credentials required."
          },
          "response": []
        },
        {
          "name": "Current membership",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Returns the authenticated tenant, membership, server-derived roles, and capabilities."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Ends the browser session. Native clients discard their securely stored bearer token after success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "List leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads?limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "leads?limit=25"
              ]
            },
            "description": "Tenant-scoped paginated lead summaries. Use returned IDs; do not manufacture owner, score, city, or clinical facts."
          },
          "response": []
        },
        {
          "name": "Create lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "lead:{{guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "leads"
              ]
            },
            "description": "Requires a source ID and source provenance. Reuse the same idempotency key after an uncertain network outcome.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example\",\n  \"phone\": \"+919999999999\",\n  \"sourceId\": \"{{sourceId}}\",\n  \"platform\": \"postman\",\n  \"origin\": \"manual\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Calls and mandatory structured remarks",
      "item": [
        {
          "name": "Record call attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "call:{{guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calls"
              ]
            },
            "description": "Creates a call attempt for the selected lead. Provider facts do not establish meaningful contact.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leadId\": \"{{leadId}}\",\n  \"direction\": \"outbound\",\n  \"disposition\": \"answered\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Save structured remark",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "remark:{{guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calls/{{callAttemptId}}/remarks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "{{callAttemptId}}",
                "remarks"
              ]
            },
            "description": "Meaningful contact needs a statement. A next commitment requires its accountable membership ID and due time. Handle 409 by refreshing before retrying.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disposition\": \"meaningful_connection\",\n  \"patientStatement\": \"Patient requested a follow-up after reviewing information.\",\n  \"nextAction\": \"Confirm follow-up availability\",\n  \"nextActionOwnerMembershipId\": \"{{membershipId}}\",\n  \"nextActionDueAt\": \"2026-09-20T10:00:00+05:30\"\n}"
            }
          },
          "response": []
        }
      ]
    }
  ]
}
